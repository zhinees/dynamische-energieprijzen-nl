{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/OWNER/dynamische-energieprijzen-nl/main/schema/prices.schema.json",
  "title": "data/prices/YYYY/YYYY-MM-DD.json",
  "type": "object",
  "required": [
    "version",
    "date",
    "timezone",
    "currency",
    "vat",
    "fetchedAt",
    "electricity",
    "gas"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "timezone": {
      "const": "Europe/Amsterdam"
    },
    "currency": {
      "const": "EUR"
    },
    "vat": {
      "const": "excluded"
    },
    "fetchedAt": {
      "type": "string"
    },
    "electricity": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "unit",
            "source",
            "hourly"
          ],
          "properties": {
            "unit": {
              "const": "EUR/kWh"
            },
            "source": {
              "enum": [
                "entsoe",
                "energyzero"
              ]
            },
            "hourly": {
              "type": "array",
              "minItems": 23,
              "maxItems": 25,
              "items": {
                "$ref": "#/$defs/point"
              }
            },
            "quarterHourly": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/point"
              }
            }
          }
        }
      ]
    },
    "gas": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "unit",
            "source",
            "hourly"
          ],
          "properties": {
            "unit": {
              "const": "EUR/m3"
            },
            "source": {
              "const": "energyzero"
            },
            "hourly": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/point"
              }
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "startUtc",
        "price"
      ],
      "properties": {
        "start": {
          "type": "string",
          "description": "Local time with offset"
        },
        "startUtc": {
          "type": "string"
        },
        "price": {
          "type": "number"
        }
      }
    }
  }
}