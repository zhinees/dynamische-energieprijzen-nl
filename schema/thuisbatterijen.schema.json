{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/zhinees/dynamische-energieprijzen-nl/main/schema/thuisbatterijen.schema.json",
  "title": "data/thuisbatterijen.json",
  "description": "Aanschafprijzen van thuisbatterijen per type en capaciteit (bandbreedte, incl. btw), met de prijs per kWh, de levensduur en de bronnen. Gemaakt door `npm run thuisbatterijen`.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "gegenereerdOp",
    "gecontroleerdOp",
    "valuta",
    "typen",
    "prijzen",
    "levensduur",
    "controlebronnen"
  ],
  "properties": {
    "gegenereerdOp": {
      "type": "string",
      "format": "date-time"
    },
    "gecontroleerdOp": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "typen": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vast",
        "stekker"
      ],
      "properties": {
        "vast": {
          "type": "string"
        },
        "stekker": {
          "type": "string"
        }
      }
    },
    "prijzen": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "capaciteitKwh",
          "prijsInclBtw",
          "bron",
          "bronDatum",
          "prijsPerKwhInclBtw"
        ],
        "properties": {
          "type": {
            "enum": [
              "vast",
              "stekker"
            ]
          },
          "capaciteitKwh": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "prijsInclBtw": {
            "$ref": "#/$defs/bereik",
            "description": "Aanschafprijs incl. 21% btw (vaste batterij: incl. installatie)"
          },
          "bron": {
            "type": "string",
            "format": "uri"
          },
          "bronDatum": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "notitie": {
            "type": "string"
          },
          "prijsPerKwhInclBtw": {
            "$ref": "#/$defs/bereik",
            "description": "prijsInclBtw ÷ capaciteitKwh, afgerond op centen"
          }
        }
      }
    },
    "levensduur": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jaren",
        "garantie",
        "bronnen"
      ],
      "properties": {
        "jaren": {
          "$ref": "#/$defs/bereik"
        },
        "garantie": {
          "type": "string"
        },
        "bronnen": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "controlebronnen": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url",
          "notitie"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "notitie": {
            "type": "string"
          }
        }
      }
    },
    "valuta": {
      "const": "EUR"
    }
  },
  "$defs": {
    "bereik": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "van",
        "tot"
      ],
      "properties": {
        "van": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "tot": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    }
  }
}
