{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/zhinees/dynamische-energieprijzen-nl/main/schema/prijzen-index.schema.json",
  "title": "data/prijzen/index.json",
  "type": "object",
  "required": [
    "versie",
    "gegenereerdOp",
    "eerste",
    "laatste",
    "dagen"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "versie": {
      "const": 1
    },
    "gegenereerdOp": {
      "type": "string"
    },
    "eerste": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      ]
    },
    "laatste": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      ]
    },
    "dagen": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      }
    }
  }
}
