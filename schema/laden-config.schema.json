{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/zhinees/energieprijzen-nl/main/schema/laden-config.schema.json",
  "title": "laden/laden.json",
  "description": "Thuis laden: de ERE-vergoeding per thuis geladen kWh en de aanschafprijs van een laadpaal (bandbreedtes), met de hand uit openbare overzichten, met bronnen.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "gecontroleerdOp",
    "ere",
    "laadpaal"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "$comment": {
      "type": "string"
    },
    "gecontroleerdOp": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "ere": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "omschrijving",
        "voorwaarden",
        "perKwh",
        "bronnen"
      ],
      "properties": {
        "omschrijving": {
          "type": "string"
        },
        "voorwaarden": {
          "type": "string"
        },
        "perKwh": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "richtwaarde",
            "van",
            "tot"
          ],
          "properties": {
            "richtwaarde": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            },
            "van": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            },
            "tot": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            }
          }
        },
        "bronnen": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "url",
              "datum"
            ],
            "properties": {
              "url": {
                "type": "string",
                "format": "uri"
              },
              "datum": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "notitie": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "laadpaal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "omschrijving",
        "prijsInclBtw",
        "bronnen"
      ],
      "properties": {
        "omschrijving": {
          "type": "string"
        },
        "prijsInclBtw": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "van",
            "tot"
          ],
          "properties": {
            "van": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "tot": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "bronnen": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "url",
              "datum"
            ],
            "properties": {
              "url": {
                "type": "string",
                "format": "uri"
              },
              "datum": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "notitie": {
                "type": "string"
              }
            }
          }
        },
        "controlebronnen": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "url",
              "notitie"
            ],
            "properties": {
              "url": {
                "type": "string",
                "format": "uri"
              },
              "notitie": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
