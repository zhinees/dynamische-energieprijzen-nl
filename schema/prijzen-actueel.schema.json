{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/zhinees/dynamische-energieprijzen-nl/main/schema/prijzen-actueel.schema.json",
  "title": "data/prijzen/actueel.json",
  "type": "object",
  "required": [
    "versie",
    "gegenereerdOp",
    "vandaag",
    "morgen"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "versie": {
      "const": 1
    },
    "gegenereerdOp": {
      "type": "string"
    },
    "vandaag": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "prijzen.schema.json"
        }
      ]
    },
    "morgen": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "prijzen.schema.json"
        }
      ]
    }
  }
}
