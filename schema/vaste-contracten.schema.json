{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/zhinees/dynamische-energieprijzen-nl/main/schema/vaste-contracten.schema.json",
  "title": "data/vaste-contracten.json",
  "description": "Vaste stroomcontracten van leveranciers voor nieuwe klanten, incl. btw; leveringstarief zonder energiebelasting; terugleverkosten per kWh of als staffel (bedrag per maand per band van de teruglevering per jaar).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "gegenereerdOp",
    "gecontroleerdOp",
    "valuta",
    "inclBtw",
    "omschrijving",
    "contracten"
  ],
  "$defs": {
    "bedrag": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bedragInclBtw",
        "bedragExclBtw",
        "eenheid",
        "bronUrl",
        "gecontroleerdOp"
      ],
      "properties": {
        "bedragInclBtw": {
          "type": "number"
        },
        "bedragExclBtw": {
          "type": "number"
        },
        "eenheid": {
          "type": "string"
        },
        "bronUrl": {
          "type": "string",
          "format": "uri"
        },
        "gecontroleerdOp": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "notitie": {
          "type": "string"
        }
      }
    }
  },
  "properties": {
    "gegenereerdOp": {
      "type": "string",
      "format": "date-time"
    },
    "gecontroleerdOp": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "valuta": {
      "const": "EUR"
    },
    "inclBtw": {
      "const": true
    },
    "omschrijving": {
      "type": "string"
    },
    "contracten": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "leverancier",
          "naam",
          "looptijdMaanden",
          "tariefUrl",
          "tarieven"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "leverancier": {
            "type": "string"
          },
          "leverancierId": {
            "type": "string"
          },
          "naam": {
            "type": "string"
          },
          "looptijdMaanden": {
            "type": [
              "integer",
              "null"
            ]
          },
          "tariefUrl": {
            "type": "string",
            "format": "uri"
          },
          "postcode": {
            "type": "string"
          },
          "geldigVanaf": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "notitie": {
            "type": "string"
          },
          "tarieven": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "stroomLeveringPerKwh",
              "stroomVastPerMaand",
              "terugleververgoedingPerKwh"
            ],
            "properties": {
              "stroomLeveringPerKwh": {
                "$ref": "#/$defs/bedrag"
              },
              "stroomVastPerMaand": {
                "$ref": "#/$defs/bedrag"
              },
              "terugleververgoedingPerKwh": {
                "$ref": "#/$defs/bedrag"
              },
              "terugleverkostenPerKwh": {
                "$ref": "#/$defs/bedrag"
              }
            }
          },
          "terugleverStaffels": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "totKwh",
                "perMaand"
              ],
              "properties": {
                "totKwh": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "perMaand": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "bedragInclBtw",
                    "bedragExclBtw"
                  ],
                  "properties": {
                    "bedragInclBtw": {
                      "type": "number"
                    },
                    "bedragExclBtw": {
                      "type": "number"
                    }
                  }
                }
              }
            }
          },
          "staffelBron": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "bronUrl",
              "gecontroleerdOp"
            ],
            "properties": {
              "bronUrl": {
                "type": "string",
                "format": "uri"
              },
              "gecontroleerdOp": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "notitie": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
