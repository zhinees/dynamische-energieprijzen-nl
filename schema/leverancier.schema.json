{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/zhinees/dynamische-energieprijzen-nl/main/schema/leverancier.schema.json",
  "title": "Leveranciersbestand",
  "description": "Eén bestand per leverancier in /leveranciers. Alle tarieven zijn per eenheid. Vul het bedrag in zoals de site het toont; de uitvoer bevat het bedrag inclusief én exclusief btw.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "naam",
    "website",
    "tariefUrl",
    "producten",
    "kenmerken",
    "regels",
    "handmatig"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "$comment": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "naam": {
      "type": "string"
    },
    "website": {
      "type": "string",
      "format": "uri"
    },
    "tariefUrl": {
      "type": "string",
      "format": "uri"
    },
    "ophalen": {
      "enum": [
        "http",
        "browser"
      ],
      "description": "'browser' gebruikt headless Chromium voor pagina's die prijzen met JavaScript laden."
    },
    "producten": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stroom",
        "gas"
      ],
      "properties": {
        "stroom": {
          "type": "boolean"
        },
        "gas": {
          "type": "boolean"
        }
      }
    },
    "kenmerken": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "automatischAfschakelen"
      ],
      "properties": {
        "automatischAfschakelen": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "De leverancier kan teruglevering automatisch stoppen bij negatieve prijzen. null = niet gecontroleerd."
        },
        "notities": {
          "type": "string"
        }
      }
    },
    "regels": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stroomVastPerMaand": {
          "oneOf": [
            {
              "$ref": "#/$defs/regel"
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/regel"
              }
            }
          ]
        },
        "stroomInkoopopslag": {
          "oneOf": [
            {
              "$ref": "#/$defs/regel"
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/regel"
              }
            }
          ]
        },
        "gasVastPerMaand": {
          "oneOf": [
            {
              "$ref": "#/$defs/regel"
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/regel"
              }
            }
          ]
        },
        "gasInkoopopslag": {
          "oneOf": [
            {
              "$ref": "#/$defs/regel"
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/regel"
              }
            }
          ]
        },
        "terugleverCorrectie": {
          "oneOf": [
            {
              "$ref": "#/$defs/regel"
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/regel"
              }
            }
          ]
        }
      }
    },
    "handmatig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stroomVastPerMaand": {
          "$ref": "#/$defs/handmatig"
        },
        "stroomInkoopopslag": {
          "$ref": "#/$defs/handmatig"
        },
        "gasVastPerMaand": {
          "$ref": "#/$defs/handmatig"
        },
        "gasInkoopopslag": {
          "$ref": "#/$defs/handmatig"
        },
        "terugleverCorrectie": {
          "$ref": "#/$defs/handmatig"
        }
      }
    },
    "rekentool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter",
        "testadres"
      ],
      "description": "Lees tarieven uit de eigen prijsrekentool van de leverancier (adapter in src/rekentools/). Gebruik een openbaar adres, nooit een privéwoning.",
      "properties": {
        "adapter": {
          "type": "string"
        },
        "testadres": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "postcode",
            "huisnummer",
            "plaats",
            "omschrijving"
          ],
          "properties": {
            "postcode": {
              "type": "string",
              "pattern": "^[1-9][0-9]{3}[A-Z]{2}$"
            },
            "huisnummer": {
              "type": "integer",
              "minimum": 1
            },
            "huisnummerToevoeging": {
              "type": "string"
            },
            "plaats": {
              "type": "string"
            },
            "omschrijving": {
              "type": "string",
              "minLength": 3
            }
          }
        }
      }
    }
  },
  "$defs": {
    "regel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "labels",
        "bereik"
      ],
      "properties": {
        "labels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Regexen (hoofdletterongevoelig) voor de tekst vlak vóór het bedrag (of erna, met 'ervoor'). In volgorde geprobeerd."
        },
        "bereik": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2,
          "description": "[min, max] als controle, toegepast na 'negatief' en vóór de btw-omrekening."
        },
        "venster": {
          "type": "integer",
          "minimum": 5,
          "maximum": 1000,
          "description": "Aantal tekens naast het label om te doorzoeken. Standaard 160."
        },
        "sectie": {
          "type": "string",
          "description": "Regex; het zoeken begint bij de eerste match. Standaard: een kop met stroom/elektriciteit of gas."
        },
        "negatief": {
          "type": "boolean",
          "description": "Sla het bedrag negatief op (kosten die als positief getal op de pagina staan, bijv. terugleverkosten)."
        },
        "url": {
          "type": "string",
          "format": "uri",
          "description": "Andere pagina dan tariefUrl voor dit veld."
        },
        "ervoor": {
          "type": "boolean",
          "description": "Het bedrag staat vóór het label, bijv. '€ 5,99 vaste kosten'."
        },
        "inclBtw": {
          "type": "boolean",
          "description": "De pagina toont dit bedrag incl. 21% btw; het wordt omgerekend naar excl. btw."
        }
      }
    },
    "handmatig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "waarde",
        "inclBtw",
        "geverifieerd",
        "gecontroleerdOp",
        "bron"
      ],
      "properties": {
        "waarde": {
          "type": "number"
        },
        "inclBtw": {
          "type": "boolean"
        },
        "geverifieerd": {
          "const": true,
          "description": "Moet true zijn: de waarde is op gecontroleerdOp gelezen op de eigen site van de leverancier. Ongecontroleerde waarden worden geweigerd."
        },
        "gecontroleerdOp": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "bron": {
          "type": "string",
          "minLength": 1,
          "description": "URL van de pagina waar je het las, of een beschrijving van de bron."
        },
        "notitie": {
          "type": "string"
        },
        "waardeInclBtw": {
          "type": [
            "number",
            "null"
          ],
          "description": "Het bedrag incl. btw zoals gepubliceerd, als de bron beide noemt. null = onbekend of er btw over gaat."
        }
      }
    }
  }
}
