{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/zhinees/dynamische-energieprijzen-nl/main/schema/vergelijking.schema.json",
  "title": "data/vergelijking/actueel.json",
  "type": "object",
  "required": [
    "versie",
    "gegenereerdOp",
    "valuta",
    "btw",
    "vandaag",
    "morgen"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "versie": {
      "const": 1
    },
    "gegenereerdOp": {
      "type": "string"
    },
    "valuta": {
      "const": "EUR"
    },
    "btw": {
      "const": "inclusief"
    },
    "opmerking": {
      "type": "string"
    },
    "vandaag": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/dag"
        }
      ]
    },
    "morgen": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/dag"
        }
      ]
    }
  },
  "$defs": {
    "dag": {
      "type": "object",
      "required": [
        "datum",
        "leveranciers",
        "uren"
      ],
      "properties": {
        "datum": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "stroomBron": {
          "type": [
            "string",
            "null"
          ]
        },
        "gasMarktgemiddeldeInclBtw": {
          "type": [
            "number",
            "null"
          ]
        },
        "leveranciers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "naam",
              "geverifieerd",
              "vastPerMaandInclBtw",
              "gasPrijsInclBtw"
            ]
          }
        },
        "uren": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "start",
              "startUtc",
              "marktInclBtw",
              "afnameInclBtw",
              "terugleveringInclBtw"
            ],
            "properties": {
              "marktInclBtw": {
                "type": "number"
              },
              "afnameInclBtw": {
                "type": "object",
                "additionalProperties": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              },
              "terugleveringInclBtw": {
                "type": "object",
                "additionalProperties": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
