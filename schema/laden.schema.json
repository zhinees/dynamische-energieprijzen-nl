{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/zhinees/dynamische-energieprijzen-nl/main/schema/laden.schema.json",
  "title": "data/laden.json",
  "description": "Thuis laden: de ERE-vergoeding per thuis geladen kWh (richtwaarde en bandbreedte, na de kosten van de inboeker) en de aanschafprijs van een laadpaal met installatie, incl. btw, met bronnen. Gemaakt door `npm run laden`.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "gegenereerdOp",
    "gecontroleerdOp",
    "valuta",
    "ere",
    "laadpaal"
  ],
  "properties": {
    "gegenereerdOp": {
      "type": "string",
      "format": "date-time"
    },
    "gecontroleerdOp": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "valuta": {
      "const": "EUR"
    },
    "ere": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "omschrijving",
        "voorwaarden",
        "perKwh",
        "bronnen"
      ],
      "properties": {
        "omschrijving": {
          "type": "string"
        },
        "voorwaarden": {
          "type": "string"
        },
        "perKwh": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "richtwaarde",
            "van",
            "tot"
          ],
          "properties": {
            "richtwaarde": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            },
            "van": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            },
            "tot": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            }
          }
        },
        "bronnen": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "url",
              "datum"
            ],
            "properties": {
              "url": {
                "type": "string",
                "format": "uri"
              },
              "datum": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "notitie": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "laadpaal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "omschrijving",
        "prijsInclBtw",
        "bronnen"
      ],
      "properties": {
        "omschrijving": {
          "type": "string"
        },
        "prijsInclBtw": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "van",
            "tot"
          ],
          "properties": {
            "van": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "tot": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "bronnen": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "url",
              "datum"
            ],
            "properties": {
              "url": {
                "type": "string",
                "format": "uri"
              },
              "datum": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "notitie": {
                "type": "string"
              }
            }
          }
        },
        "controlebronnen": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "url",
              "notitie"
            ],
            "properties": {
              "url": {
                "type": "string",
                "format": "uri"
              },
              "notitie": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
