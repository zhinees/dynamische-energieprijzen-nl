{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/zhinees/dynamische-energieprijzen-nl/main/schema/prijzen.schema.json",
  "title": "data/prijzen/JJJJ/JJJJ-MM-DD.json",
  "type": "object",
  "required": [
    "versie",
    "datum",
    "tijdzone",
    "valuta",
    "opgehaaldOp",
    "stroom",
    "gas"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "versie": {
      "const": 1
    },
    "datum": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "tijdzone": {
      "const": "Europe/Amsterdam"
    },
    "valuta": {
      "const": "EUR"
    },
    "opgehaaldOp": {
      "type": "string"
    },
    "stroom": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "eenheid",
            "bron",
            "perUur"
          ],
          "properties": {
            "eenheid": {
              "const": "EUR/kWh"
            },
            "bron": {
              "enum": [
                "entsoe",
                "energyzero"
              ]
            },
            "perUur": {
              "type": "array",
              "minItems": 23,
              "maxItems": 25,
              "items": {
                "$ref": "#/$defs/punt"
              }
            },
            "perKwartier": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/punt"
              }
            }
          }
        }
      ]
    },
    "gas": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "eenheid",
            "bron",
            "perUur"
          ],
          "properties": {
            "eenheid": {
              "const": "EUR/m3"
            },
            "bron": {
              "const": "energyzero"
            },
            "perUur": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/punt"
              }
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "punt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "startUtc",
        "prijsInclBtw",
        "prijsExclBtw"
      ],
      "properties": {
        "start": {
          "type": "string",
          "description": "Lokale tijd met tijdverschil"
        },
        "startUtc": {
          "type": "string"
        },
        "prijsInclBtw": {
          "type": "number",
          "description": "Marktprijs inclusief 21% btw (zonder energiebelasting en opslag van de leverancier)"
        },
        "prijsExclBtw": {
          "type": "number"
        }
      }
    }
  }
}
