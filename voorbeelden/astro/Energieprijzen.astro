---
// Drop into an Astro project (works with the Cloudflare adapter too).
// Usage: <Energieprijzen uur={18} />
//
// With `export const prerender = false` on the page, this runs per request;
// otherwise it runs at build time. The data refreshes a few times a day, so
// a short cache in front is plenty.
interface Props {
  uur?: number;
  basis?: string;
}
const {
  uur = 18,
  basis = "https://raw.githubusercontent.com/zhinees/dynamische-energieprijzen-nl/main/data",
} = Astro.props;

let dag: any = null;
let fout = "";
try {
  const res = await fetch(`${basis}/vergelijking/actueel.json`);
  dag = (await res.json()).vandaag;
} catch (e) {
  fout = "Prijzen zijn nu niet beschikbaar.";
}

const slot = dag?.uren.find((u: any) => Number(u.start.slice(11, 13)) === uur);
const rijen = slot
  ? dag.leveranciers
      .map((l: any) => ({ ...l, afname: slot.afname[l.id], teruglevering: slot.teruglevering[l.id] }))
      .sort((a: any, b: any) => (a.afname ?? 9) - (b.afname ?? 9))
  : [];
const eur = (n: number | null) =>
  n === null || n === undefined ? "–" : n.toLocaleString("nl-NL", { style: "currency", currency: "EUR", minimumFractionDigits: 4 });
---
<section class="energie">
  {fout && <p>{fout}</p>}
  {slot && (
    <>
      <p>
        Beursprijs vandaag om {String(uur).padStart(2, "0")}:00: <strong>{eur(slot.markt)}</strong> per kWh (excl. btw)
      </p>
      <table>
        <thead>
          <tr><th>Leverancier</th><th>Afname /kWh</th><th>Teruglevering /kWh</th><th>Vast /mnd</th></tr>
        </thead>
        <tbody>
          {rijen.map((l: any) => (
            <tr>
              <td>{l.naam}</td>
              <td>{eur(l.afname)}</td>
              <td>{eur(l.teruglevering)}</td>
              <td>{eur(l.vastPerMaand.stroom)}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p><small>Excl. btw, energiebelasting en netbeheerkosten. – = niet gepubliceerd door de leverancier.</small></p>
    </>
  )}
</section>

<style>
  .energie table { border-collapse: collapse; width: 100%; }
  .energie th, .energie td { padding: 0.4rem 0.6rem; border-bottom: 1px solid #ddd; text-align: left; }
  .energie td:not(:first-child), .energie th:not(:first-child) { text-align: right; font-variant-numeric: tabular-nums; }
</style>
