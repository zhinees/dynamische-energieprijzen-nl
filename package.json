  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "leveranciers": "node src/leveranciers-scrapen.ts",
    "belasting": "node src/belasting-ophalen.ts",
    "afleiden": "node src/afleiden.ts",
    "rekenhulp": "node src/rekenhulp.ts",
    "debug": "node src/debug-leverancier.ts",
    "valideer": "node src/valideren.ts",
    "test": "node --test \"test/*.test.ts\"",
    "typecontrole": "tsc",
    "controleer": "npm run typecontrole && npm test && npm run valideer"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
